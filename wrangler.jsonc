{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exit-system",
  "compatibility_date": "2026-02-06",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exit-system-production",
      "database_id": ""
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "exit-system-mailroom"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}